# Automatic (tickless) light sleep: FreeRTOS drops the SoC into light sleep
# by itself whenever every task is blocked, and wakes it again for the next
# scheduled tick/timeout — see power_management_init() in src/main.cpp.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# The board PlatformIO detects at flash time is an 8MB module
# (esp32-s3-devkitc-1-N8); match it explicitly instead of the generic 2MB
# default so partitions.csv (sized for 8MB) actually fits.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
